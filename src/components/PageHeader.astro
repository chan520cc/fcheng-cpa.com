---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  crumbs?: { href: string; label: string }[];
}
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---

<section class="border-b border-ink/10 bg-cream">
  <div class="container-page py-14 md:py-20">
    {
      crumbs.length > 0 && (
        <nav aria-label="麵包屑" class="mb-6 text-sm text-ink-soft">
          <a href="/" class="hover:text-copper">首頁</a>
          {crumbs.map((c) => (
            <>
              <span class="mx-2">/</span>
              <a href={c.href} class="hover:text-copper">{c.label}</a>
            </>
          ))}
        </nav>
      )
    }
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 text-3xl font-bold sm:text-5xl">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg text-ink-soft">{lead}</p>}
  </div>
</section>
