---
import Icon from './Icon.astro';
import { contact, mailtoHref } from '../data/site';
---

<section class="bg-cream">
  <div class="container-page flex flex-col items-start justify-between gap-8 py-16 md:flex-row md:items-center">
    <div>
      <h2 class="text-2xl font-bold sm:text-3xl">聯絡我們</h2>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={contact.phoneHref} class="btn-primary tabular-nums"><Icon name="phone" />{contact.phone}</a>
      <a href={mailtoHref} class="btn-ghost bg-white"><Icon name="mail" />Email 詢問</a>
    </div>
  </div>
</section>
