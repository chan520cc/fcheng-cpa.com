---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactCta from '../../components/ContactCta.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/site';
---

<Base title="服務項目" description={`服務項目：${services.map((s) => s.title).join('、')}`}>
  <PageHeader eyebrow="Services" title="服務項目" />

  <div class="container-page space-y-6 py-16 md:py-20">
    {
      services.map((s, i) => (
        <a href={`/services/${s.slug}`} class="group grid gap-6 rounded-2xl border border-ink/10 bg-white p-8 transition hover:border-copper/40 hover:shadow-lg md:grid-cols-[auto_1fr_auto] md:items-center md:p-10">
          <span class="font-serif text-4xl font-bold text-sand">0{i + 1}</span>
          <div>
            <h2 class="text-2xl font-bold">
              {s.title}
              <span class="ml-2 text-sm font-normal tracking-widest text-ink-soft">{s.titleEn}</span>
            </h2>
            <div class="mt-4 flex flex-wrap gap-2">
              {s.sections.flatMap((sec) => sec.items).slice(0, 6).map((item) => (
                <span class="rounded-full bg-cream px-3 py-1 text-sm">{item}</span>
              ))}
            </div>
          </div>
          <Icon name="arrow" class="size-6 text-copper transition group-hover:translate-x-1" />
        </a>
      ))
    }
  </div>

  <ContactCta />
</Base>
