---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactCta from '../../components/ContactCta.astro';
import { services, type Service } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const others = services.filter((s) => s.slug !== service.slug);
---

<Base title={service.title} description={`${service.title}：${service.highlights.join('、')}`}>
  <PageHeader
    eyebrow={service.titleEn}
    title={service.title}
    crumbs={[{ href: '/services', label: '服務項目' }]}
  />

  <div class="container-page grid gap-12 py-16 md:py-20 lg:grid-cols-[14rem_1fr]">
    {
      service.sections.length > 1 && (
        <aside class="hidden lg:block">
          <nav class="sticky top-24 space-y-1 border-l border-ink/10 text-sm" aria-label="本頁目錄">
            {service.sections.map((sec, i) => (
              <a href={`#s${i + 1}`} class="-ml-px block border-l border-transparent py-1.5 pl-4 text-ink-soft hover:border-copper hover:text-copper">
                {sec.title}
              </a>
            ))}
          </nav>
        </aside>
      )
    }

    <div class:list={['space-y-16', service.sections.length === 1 && 'lg:col-span-2 lg:max-w-4xl']}>
      {
        service.sections.map((sec, i) => (
          <section id={`s${i + 1}`} class="scroll-mt-24">
            {sec.titleEn && <p class="eyebrow">{sec.titleEn}</p>}
            <h2 class="mt-2 text-2xl font-bold sm:text-3xl">{sec.title}</h2>
            <p class="mt-5 text-ink-soft">{sec.intro}</p>
            <h3 class="mt-8 font-sans text-base font-semibold">我們的服務包括</h3>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {sec.items.map((item) => (
                <li class="flex gap-3 rounded-xl border border-ink/10 bg-white px-5 py-4">
                  <svg class="mt-1 size-4 shrink-0 text-copper" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.58l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>

  <section class="container-page pb-16">
    <h2 class="text-lg font-bold">其他服務</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        others.map((s) => (
          <a href={`/services/${s.slug}`} class="rounded-xl border border-ink/10 bg-white p-6 transition hover:border-copper/40">
            <p class="font-serif text-xl font-bold">{s.title}</p>
            <p class="mt-1 text-sm text-ink-soft">{s.highlights.join('、')}</p>
          </a>
        ))
      }
    </div>
  </section>

  <ContactCta />
</Base>
