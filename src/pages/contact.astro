---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { contact, mailtoHref } from '../data/site';

const details = [
  { icon: 'pin', label: '地址', value: contact.address },
  { icon: 'fax', label: '傳真', value: contact.fax },
  ...(contact.hours ? [{ icon: 'clock', label: '營業時間', value: contact.hours }] : []),
] as const;
---

<Base title="聯絡我們" description={`聯絡賦誠會計師事務所：電話 ${contact.phone}、Email ${contact.email}，地址 ${contact.address}。`}>
  <PageHeader eyebrow="Contact" title="聯絡我們" />

  <div class="container-page py-16 md:py-20">
    <!-- 主要聯絡方式 -->
    <div class="grid gap-5 md:grid-cols-2">
      <a href={contact.phoneHref} class="group flex flex-col rounded-2xl bg-ink p-8 text-paper transition hover:bg-ink/95 md:p-10">
        <span class="flex size-12 items-center justify-center rounded-full bg-copper text-white">
          <Icon name="phone" class="size-6" />
        </span>
        <p class="mt-6 text-sm tracking-widest text-sand">電話</p>
        <p class="mt-1 font-serif text-3xl font-bold tabular-nums sm:text-4xl">{contact.phone}</p>
      </a>

      <a href={mailtoHref} class="group flex flex-col rounded-2xl border border-ink/10 bg-white p-8 transition hover:border-copper/40 hover:shadow-lg md:p-10">
        <span class="flex size-12 items-center justify-center rounded-full bg-cream text-copper">
          <Icon name="mail" class="size-6" />
        </span>
        <p class="mt-6 text-sm tracking-widest text-copper">Email</p>
        <p class="mt-1 text-xl font-medium break-all sm:text-2xl">{contact.email}</p>
      </a>
    </div>

    <!-- 地址、傳真 -->
    <ul class="mt-5 grid divide-y divide-ink/10 rounded-2xl border border-ink/10 bg-white md:grid-cols-2 md:divide-x md:divide-y-0">
      {
        details.map((d) => (
          <li class="flex items-start gap-4 px-8 py-6">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-cream text-copper">
              <Icon name={d.icon} />
            </span>
            <div>
              <p class="text-sm text-ink-soft">{d.label}</p>
              <p class="text-lg tabular-nums">{d.value}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
